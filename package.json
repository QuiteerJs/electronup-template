{
  "name": "electronup-template",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "main": "dist/resource/electron.cjs",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electronup",
    "build": "electronup build",
    "build:dir": "electronup build --dir",
    "build:win": "electronup build --win",
    "build:win32": "electronup build --win ia32",
    "build:win64": "electronup build --win x64",
    "build:mac": "electronup build --mac",
    "build:mac-x64": "electronup build --mac x64",
    "build:mac-arm64": "electronup build --mac arm64",
    "build:mac-universal": "electronup build --mac universal",
    "build:linux": "electronup build --linux",
    "build:option": "electronup build -o",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "upgrade:latest": "pnpm update --latest",
    "upgrade:interactive": "pnpm update --interactive --latest",
    "commit": "qui gc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit --composite false",
    "build:web": "electronup build --web"
  },
  "dependencies": {
    "@quiteer/electron-ipc": "^3.0.1",
    "@quiteer/electron-preload": "^1.0.0",
    "electron-updater": "^6.8.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.6.1",
    "@quiteer/scripts": "^0.1.6",
    "@types/node": "^24.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "electron": "^45.0.0",
    "electronup": "^0.3.1",
    "eslint": "^10.0.2",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.9.3",
    "vite": "npm:vite-plus@^1.3.0"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm qui gv",
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
